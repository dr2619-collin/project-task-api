# Local development database created by scripts/setup_database.sql.
# Demo credentials only. Never reuse or commit real credentials.
# Production credentials should come from a secret manager.
STORAGE_BACKEND=database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/project_task

# Set to true to print SQLAlchemy-generated SQL in the development terminal.
DATABASE_ECHO_SQL=true
