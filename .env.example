# Local course-demo database created by scripts/setup_database.sql.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/project_task

# Set to true to print SQLAlchemy-generated SQL in the development terminal.
DATABASE_ECHO_SQL=false

# Course-demo Bearer tokens. These values demonstrate request
# authentication and role-based authorization; they are not production secrets.
DEMO_MEMBER_TOKEN=member-demo-token
DEMO_ADMIN_TOKEN=admin-demo-token
